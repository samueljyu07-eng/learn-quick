# Copy this file to .env.local and paste your key after the equals sign.
# Learn Quick reads .env.local automatically. Do not put the key in any other file.
# Get a key at https://console.anthropic.com/settings/keys
# Definitions and later steps read this key. Step 1 works before you add it.
ANTHROPIC_API_KEY=

# Supabase, for accounts. Create a project at https://supabase.com/dashboard
# Project URL and the anon key are public. The service role key is a server secret:
# it saves hardcore locks and points, and it must not be used in browser code.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
